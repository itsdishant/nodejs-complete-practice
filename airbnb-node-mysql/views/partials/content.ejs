<%#
  Shared page shell. Every view is just page content (a fragment);
  controllers/appController.js renders the fragment and injects it here as `body`,
  so no page repeats the doctype / head / header / main boilerplate.
%>
<!doctype html>
<html lang="en">
  <%- include("./head") %>
  <body class="min-h-screen bg-paper antialiased text-ink">
    <%- include("./header") %>
    <main class="mx-auto min-h-[calc(100svh-5rem)] max-w-6xl px-4 py-8 sm:px-6 sm:py-12">
      <%- body %>
    </main>
    <script src="/vendor/notyf/notyf.min.js"></script>
    <script>
      const notyf = new Notyf({ duration: 4000, dismissible: true });
      (function () {
        // Escape "<" so no notice text can close this script tag.
        const notice = <%- JSON.stringify(typeof notice === "undefined" ? null : notice).replace(/</g, "\\u003c") %>;
        if (!notice) return;
        notyf[notice.type === "error" ? "error" : "success"](notice.message);
        // Drop ?notice= from the URL so a reload doesn't repeat the toast.
        if (location.search.includes("notice=")) {
          history.replaceState(null, "", location.pathname);
        }
      })();
    </script>
  </body>
</html>
