<% const withLabel = typeof showLabel !== "undefined" && showLabel; %>
<form
  action="/host/favourites/<%= home.id %>"
  method="POST"
  class="inline-flex items-center"
>
  <button
    type="submit"
    class="group inline-flex items-center justify-center cursor-pointer transition-all duration-200 focus-visible:outline-offset-2 <% if (withLabel) { %>gap-2 rounded-full border px-4 py-2 text-sm font-semibold shadow-xs <%= home.isFavourite ? 'border-coral/40 bg-coral/10 text-coral hover:bg-coral/20 hover:border-coral' : 'border-pencil bg-white text-ink hover:border-ink/40 hover:bg-mist/50 hover:text-coral' %><% } else { %>h-9 w-9 shrink-0 rounded-full border shadow-sm backdrop-blur-sm hover:scale-105 <%= home.isFavourite ? 'border-coral/40 bg-white text-coral hover:border-coral' : 'border-pencil bg-white/95 text-ink/80 hover:border-ink/40 hover:bg-white hover:text-coral' %><% } %>"
    aria-label="<%= home.isFavourite ? 'Remove from saved homes' : 'Save to favourites' %>"
    aria-pressed="<%= home.isFavourite ? 'true' : 'false' %>"
  >
    <svg
      class="h-4 w-4 shrink-0 transition-transform duration-200 group-hover:scale-110 <%= home.isFavourite ? 'fill-coral text-coral' : 'fill-none text-current' %>"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="1.8"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"
      />
    </svg>
    <% if (withLabel) { %>
    <span><%= home.isFavourite ? "Saved" : "Save" %></span>
    <% } %>
  </button>
</form>
