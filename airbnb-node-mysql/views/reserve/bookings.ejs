      <!-- Page Header -->
      <header class="border-b border-pencil pb-8">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
          <div>
            <h1
              id="bookings-heading"
              class="font-display text-4xl font-medium leading-tight sm:text-5xl text-ink"
            >
              Your bookings
            </h1>
            <p class="mt-3 text-base text-ink/70">
              Confirmed stays, check-in dates, and upcoming trips.
            </p>
          </div>
        </div>
      </header>

      <!-- Bookings Content -->
      <section aria-labelledby="bookings-heading" class="mt-8">
        <% if (typeof bookings !== "undefined" && bookings.length > 0) { %>
        <div class="space-y-6">
          <% for (const booking of bookings) { %>
          <article class="group overflow-hidden rounded-sm border border-pencil bg-white shadow-xs transition-shadow hover:shadow-md">
            <div class="grid grid-cols-1 md:grid-cols-12">
              <!-- Left: Stay Thumbnail -->
              <div class="relative md:col-span-4 overflow-hidden bg-mist">
                  <img
                    class="h-60 w-full object-cover transition-transform duration-300 group-hover:scale-103 md:h-full"
                    src="<%= booking.photo || 'https://images.unsplash.com/photo-1596394516093-501ba68a0ba6?q=80&w=2340&auto=format&fit=crop' %>"
                    alt="Photo of <%= booking.homeName %>"
                    loading="lazy"
                  />
              </div>

              <!-- Center: Trip Details -->
              <div class="flex flex-1 flex-col justify-between p-6 md:col-span-5">
                <div>
                  <!-- Status & Reference -->
                  <div class="flex flex-wrap items-center gap-2">
                    <%- include("../shared/booking-id", { id: booking.id }) %>
                  </div>

                  <!-- Property Title & Location -->
                  <h2 class="mt-3 font-display text-2xl font-medium leading-snug text-ink">
                    <%= booking.homeName %>
                  </h2>
                  <p class="mt-1 flex items-center text-sm text-ink/65">
                    <svg class="mr-1.5 h-4 w-4 text-coral shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <%= booking.location %>
                  </p>
                </div>

                <!-- Schedule & Guest Specs -->
                <div class="mt-6 border-t border-pencil/70 pt-3 text-xs text-ink/75 space-y-2">
                  <div class="flex items-center gap-2 text-sm font-medium text-ink">
                    <svg class="h-4 w-4 text-ink/50 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    <span>
                      <%= booking.checkIn || 'Confirmed' %> &rarr; <%= booking.checkOut || 'Confirmed' %>
                    </span>
                  </div>
                  <div class="flex items-center gap-2 text-ink/60">
                    <span>
                      <%= booking.numberOfGuests || booking.number_of_guests || 1 %> <%= (booking.numberOfGuests == 1 || booking.number_of_guests == 1) ? 'guest' : 'guests' %>
                    </span>
                    <% if (booking.full_name || booking.fullName) { %>
                    <span>&bull;</span>
                    <span class="truncate max-w-[200px]"><%= booking.full_name || booking.fullName %></span>
                    <% } %>
                  </div>
                </div>
              </div>

              <!-- Right: Price & CTA Actions -->
              <div class="flex flex-col justify-between border-t md:border-t-0 md:border-l border-pencil bg-mist/20 p-6 md:col-span-3">
                <div>
                  <span class="text-xs font-semibold uppercase tracking-wider text-ink/50">Total paid</span>
                  <p class="mt-1 font-display text-2xl sm:text-3xl font-semibold text-ink">
                    <%= booking.formattedPrice %>
                  </p>
                  <p class="mt-1 text-xs text-ink/50">Taxes and fees included</p>
                </div>

                <div class="mt-6 flex flex-col gap-2.5">
                  <a
                    href="/bookings/<%= booking.id %>"
                    class="inline-flex min-h-11 items-center justify-center rounded-sm bg-coral px-4 text-sm font-semibold text-white transition-colors hover:bg-ink focus-visible:outline-offset-4 text-center"
                  >
                    View booking
                  </a>
                </div>
              </div>
            </div>
          </article>
          <% } %>
        </div>

        <% } else { %>
        <!-- Empty State -->
        <div class="mx-auto max-w-xl rounded-sm border border-pencil bg-white p-8 sm:p-12 text-center">
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-mist text-coral">
            <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
          <h2 class="mt-4 font-display text-2xl font-medium text-ink">No trips booked yet</h2>
          <p class="mt-2 text-sm leading-relaxed text-ink/65">
            When you reserve a place to stay, you will find your reservation details and check-in instructions right here.
          </p>
          <div class="mt-6">
            <a
              href="/host/homes-list"
              class="inline-flex min-h-11 items-center justify-center rounded-sm bg-coral px-6 text-sm font-semibold text-white transition-colors hover:bg-ink focus-visible:outline-offset-4"
            >
              Find places to stay
            </a>
          </div>
        </div>
        <% } %>
      </section>
