      <% if (typeof booking !== "undefined" && booking) { %>
      <!-- Page Header: matches home-detail & reserve layout -->
      <header class="border-b border-pencil pb-8">
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
          <div>
            <h1 class="font-display text-3xl font-medium tracking-tight text-ink sm:text-4xl lg:text-5xl">
              <%= booking.homeName %>
            </h1>
            <p class="mt-2 flex items-center text-sm text-ink/70">
              <svg class="mr-1.5 h-4 w-4 text-coral shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <%= booking.location %>
            </p>
          </div>

          <!-- Booking reference -->
          <%- include("../shared/booking-id", { id: booking.bookingId }) %>
        </div>
      </header>

      <!-- Main Content Grid: 12-column layout matching reserve & home-detail -->
      <div class="mt-8 grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-12">
        <!-- Left Column: Stay Info & Schedule (7 cols) -->
        <div class="space-y-8 lg:col-span-7">
          <!-- Property Photo Banner -->
          <div class="overflow-hidden rounded-sm border border-pencil bg-mist">
            <img
              src="<%= booking.photo || 'https://images.unsplash.com/photo-1596394516093-501ba68a0ba6?q=80&w=2340&auto=format&fit=crop' %>"
              alt="Photo of <%= booking.homeName %>"
              class="aspect-video w-full object-cover"
            />
          </div>

          <!-- Schedule Section -->
          <section aria-labelledby="schedule-heading" class="border-b border-pencil pb-8">
            <h2 id="schedule-heading" class="font-display text-xl font-medium text-ink">
              Reservation schedule
            </h2>
            <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="rounded-sm border border-pencil p-4 bg-mist/20">
                <span class="text-xs font-semibold uppercase text-ink/50">Check-in</span>
                <p class="mt-1 font-display text-lg font-medium text-ink">
                  <%= booking.checkIn || "Not set" %>
                </p>
              </div>

              <div class="rounded-sm border border-pencil p-4 bg-mist/20">
                <span class="text-xs font-semibold uppercase text-ink/50">Checkout</span>
                <p class="mt-1 font-display text-lg font-medium text-ink">
                  <%= booking.checkOut || "Not set" %>
                </p>
              </div>
            </div>
          </section>

          <!-- Guest Contact Details -->
          <section aria-labelledby="guests-heading" class="border-b border-pencil pb-8">
            <h2 id="guests-heading" class="font-display text-xl font-medium text-ink">
              Guest details
            </h2>
            <div class="mt-4 rounded-sm border border-pencil bg-white p-5 text-sm space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-ink/60">Primary guest</span>
                <span class="font-medium text-ink"><%= booking.fullName %></span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-ink/60">Email address</span>
                <span class="font-medium text-ink"><%= booking.email %></span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-ink/60">Phone number</span>
                <span class="font-medium text-ink"><%= booking.phoneNumber %></span>
              </div>
              <div class="flex items-center justify-between border-t border-pencil/70 pt-3">
                <span class="text-ink/60">Guests count</span>
                <span class="font-medium text-ink">
                  <%= booking.numberOfGuests %> <%= booking.numberOfGuests === 1 ? "guest" : "guests" %>
                </span>
              </div>
            </div>
          </section>
        </div>

        <!-- Right Column: Sticky Receipt (5 cols) -->
        <aside aria-label="Receipt" class="lg:col-span-5">
          <div class="sticky top-6 rounded-sm border border-pencil bg-white p-6 sm:p-7 shadow-sm space-y-6">
            <h2 class="font-display text-xl font-medium text-ink">Receipt</h2>

            <div class="space-y-3 text-sm text-ink/75">
              <div class="flex justify-between gap-4">
                <span>
                  <%= booking.formattedNightlyRate %> &times; <%= booking.nights %> <%= booking.nights === 1 ? "night" : "nights" %>
                </span>
                <span class="text-ink font-medium"><%= booking.formattedNightsTotal %></span>
              </div>
              <div class="flex justify-between gap-4">
                <span>Cleaning fee</span>
                <span class="text-ink font-medium"><%= booking.formattedCleaningFee %></span>
              </div>
              <div class="flex justify-between gap-4">
                <span>Airbnb service fee</span>
                <span class="text-ink font-medium"><%= booking.formattedServiceFee %></span>
              </div>
            </div>

            <hr class="border-pencil" />

            <div class="flex items-baseline justify-between gap-4 text-ink">
              <span class="text-base font-semibold">Total paid</span>
              <span class="font-display text-2xl font-semibold">
                <%= booking.formattedTotal %>
              </span>
            </div>

            <div class="flex justify-between gap-4 text-sm text-ink/75">
              <span>Payment method</span>
              <span class="font-medium text-ink"><%= booking.paymentMethodLabel %></span>
            </div>
          </div>
        </aside>
      </div>

      <% } else { %>
      <!-- Fallback / Empty State -->
      <section class="max-w-xl py-12">
        <h1 class="font-display text-3xl font-medium text-ink">Booking not found</h1>
        <p class="mt-3 text-sm text-ink/70 leading-relaxed">
          The requested booking does not exist or may have been removed.
        </p>
        <div class="mt-6 flex items-center gap-4">
          <a
            href="/bookings"
            class="inline-flex min-h-11 items-center justify-center rounded-sm bg-coral px-5 text-sm font-semibold text-white transition-colors hover:bg-ink focus-visible:outline-offset-4"
          >
            Go to your bookings
          </a>
          <a
            href="/host/homes-list"
            class="inline-flex min-h-11 items-center justify-center rounded-sm border border-pencil bg-white px-5 text-sm font-semibold text-ink transition-colors hover:border-ink hover:bg-mist focus-visible:outline-offset-4"
          >
            Explore stays
          </a>
        </div>
      </section>
      <% } %>
