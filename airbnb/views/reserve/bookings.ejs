<!-- Page Header -->
<header class="border-b border-pencil pb-8">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 id="bookings-heading" class="font-display text-4xl font-medium leading-tight text-ink sm:text-5xl">
        Your bookings
      </h1>
      <p class="mt-3 text-base text-ink/70">
        Confirmed stays, check-in dates, and upcoming trips.
      </p>
    </div>
  </div>
</header>

<!-- Bookings Content -->
<section aria-labelledby="bookings-heading" class="w-full">
  <% if (typeof bookings !=="undefined" && bookings.length> 0) { %>
    <div class="mt-8">
      <p class="mb-5 text-sm text-ink/60">
        <%= bookings.length %>
          <%= bookings.length===1 ? "booking" : "bookings" %>
      </p>

      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <% for (const booking of bookings) { %>
          <li class="flex flex-col overflow-hidden rounded-sm border border-pencil bg-white">
            <div class="group relative flex h-full flex-col">
              <!-- Stay Thumbnail with aspect-4/3 -->
              <div class="relative aspect-4/3 w-full overflow-hidden bg-mist">
                <a class="block h-full w-full" href="/bookings/<%= booking._id %>"
                  aria-label="View booking for <%= booking.homeName %>">
                  <img class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                    src="<%= booking.photo || 'https://images.unsplash.com/photo-1596394516093-501ba68a0ba6?q=80&w=2340&auto=format&fit=crop' %>"
                    alt="Photo of <%= booking.homeName %>" loading="lazy" />
                </a>
                <!-- Status Pill -->
                <div class="absolute left-3 top-3 z-10">
                  <span
                    class="inline-flex items-center rounded-xs border border-emerald-200/60 bg-white/95 px-2.5 py-0.5 text-[10px] font-semibold text-emerald-800 shadow-xs backdrop-blur-xs">
                    Confirmed
                  </span>
                </div>
              </div>

              <!-- Booking Card Details -->
              <a class="flex flex-1 flex-col justify-between p-4 text-ink no-underline"
                href="/bookings/<%= booking._id %>">
                <div class="mb-4">
                  <div class="flex items-center justify-between text-xs text-ink/60">
                    <span class="truncate">
                      <%= booking.location %>
                    </span>
                    <span class="font-mono text-[11px] text-ink/40">#<%= booking._id.toString().slice(-6) %></span>
                  </div>

                  <h2
                    class="mt-1 font-display text-lg font-medium leading-snug transition-colors group-hover:text-coral truncate">
                    <%= booking.homeName %>
                  </h2>

                  <!-- Trip Dates & Guest Specs -->
                  <p class="mt-2 text-xs font-medium text-ink/75">
                    <%= booking.checkIn || 'Confirmed' %> &ndash; <%= booking.checkOut || 'Confirmed' %>
                  </p>
                  <p class="mt-0.5 text-xs text-ink/50">
                    <%= booking.numberOfGuests || booking.number_of_guests || 1 %>
                      <%= (booking.numberOfGuests==1 || booking.number_of_guests==1) ? 'guest' : 'guests' %>
                        <% if (booking.checkIn && booking.checkOut) { const checkInDate=new Date(booking.checkIn); const
                          checkOutDate=new Date(booking.checkOut); const diffDays=Math.round((checkOutDate -
                          checkInDate) / 86400000); if (diffDays> 0) { %>
                          &bull; <%= diffDays %>
                            <%= diffDays===1 ? 'night' : 'nights' %>
                              <% } } %>
                  </p>
                </div>

                <!-- Price & Action Indicator -->
                <div class="border-t border-pencil pt-3 flex items-baseline justify-between text-sm text-ink">
                  <div>
                    <span class="font-semibold">
                      <%= booking.formattedPrice %>
                    </span>
                    <span class="text-xs text-ink/60">total</span>
                  </div>
                  <span class="text-xs font-semibold text-coral group-hover:underline">
                    View booking &rarr;
                  </span>
                </div>
              </a>
            </div>
          </li>
          <% } %>
      </ul>
    </div>

    <% } else { %>
      <!-- Empty State matching /homes -->
      <div class="max-w-xl py-12">
        <h2 class="font-display text-2xl font-medium">No trips booked yet</h2>
        <p class="mt-3 text-sm leading-6 text-ink/60">
          When you reserve a place to stay, you will find your reservation details and check-in instructions right here.
        </p>
        <a class="mt-6 inline-flex min-h-11 items-center justify-center rounded-sm bg-coral px-5 text-sm font-semibold text-white transition-colors hover:bg-ink focus-visible:outline-offset-4"
          href="/homes">
          Find places to stay
        </a>
      </div>
      <% } %>
</section>