<%
  const indiaHomes = typeof indianHomes !== "undefined" ? indianHomes : [];
  const worldHomes = typeof internationalHomes !== "undefined" ? internationalHomes : [];
  const places = typeof destinations !== "undefined" ? destinations : [];
  const total = typeof totalHomesCount !== "undefined" ? totalHomesCount : indiaHomes.length + worldHomes.length;
  const rails = [
    { id: "india", title: "Homes in India", homes: indiaHomes },
    { id: "world", title: "Stays outside India", homes: worldHomes },
  ].filter((rail) => rail.homes.length > 0);
%>

      <!-- Search -->
      <section aria-labelledby="home-heading" class="w-full">
        <h1
          id="home-heading"
          class="font-display text-4xl font-medium tracking-tight text-ink sm:text-5xl"
        >
          Find your next stay
        </h1>
        <p class="mt-3 max-w-2xl text-base text-ink/70">
          <%= total %> homes in <%= places.length %> destinations, booked directly with the people who host them.
        </p>

        <form
          action="/homes"
          method="GET"
          role="search"
          class="mt-8 flex w-full max-w-2xl items-stretch gap-2 rounded-sm border border-pencil bg-white p-2 shadow-sm transition-colors focus-within:border-ink/40"
        >
          <label for="destination" class="sr-only">Destination</label>
          <div class="flex min-w-0 flex-1 items-center gap-2 pl-2">
            <i class="iconoir-map-pin shrink-0 text-lg text-ink/40" aria-hidden="true"></i>
            <input
              id="destination"
              name="q"
              type="search"
              autocomplete="off"
              placeholder="Where to? Try Goa, Kyoto, or Munnar"
              class="min-h-11 w-full min-w-0 bg-transparent text-sm text-ink placeholder:text-ink/40 focus:outline-none"
            />
          </div>
          <button
            type="submit"
            class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-sm bg-coral px-5 text-sm font-semibold text-white transition-colors hover:bg-ink focus-visible:outline-offset-4"
          >
            Search
          </button>
        </form>
      </section>

      <% if (places.length > 0) { %>
      <!-- Destinations -->
      <section aria-labelledby="destinations-heading" class="mt-5 w-full">
        <h2 id="destinations-heading" class="sr-only">Destinations</h2>
        <ul
          class="no-scrollbar -mx-4 flex gap-2 overflow-x-auto px-4 pb-1 sm:mx-0 sm:px-0"
        >
          <% for (const place of places) { %>
          <li class="shrink-0">
            <a
              href="/homes?q=<%= encodeURIComponent(place) %>"
              class="inline-flex items-center rounded-full border border-pencil bg-white px-3.5 py-2 text-xs font-medium text-ink/80 transition-colors hover:border-ink hover:bg-mist hover:text-ink"
            ><%= place %></a>
          </li>
          <% } %>
        </ul>
      </section>
      <% } %>

      <% if (rails.length > 0) { %>
      <% for (const rail of rails) { %>
      <!-- <%= rail.title %> -->
      <section
        aria-labelledby="<%= rail.id %>-heading"
        class="mt-12 border-t border-pencil pt-8"
      >
        <div class="flex items-end justify-between gap-4">
          <h2
            id="<%= rail.id %>-heading"
            class="font-display text-xl font-medium text-ink sm:text-2xl"
          >
            <%= rail.title %>
          </h2>
          <p class="pb-0.5 text-sm text-ink/50">
            <%= rail.homes.length %> <%= rail.homes.length === 1 ? "home" : "homes" %>
          </p>
        </div>

        <ul
          class="no-scrollbar -mx-4 mt-5 flex snap-x snap-mandatory scroll-pl-4 gap-4 overflow-x-auto px-4 pb-1 sm:mx-0 sm:scroll-pl-0 sm:px-0"
        >
          <% for (const home of rail.homes) { %>
          <li
            class="w-[76%] shrink-0 snap-start overflow-hidden rounded-sm border border-pencil bg-white transition-colors hover:border-ink/30 sm:w-[46%] lg:w-75"
          >
            <%- include("./shared/single-home-card", { home: home }) %>
          </li>
          <% } %>
        </ul>
      </section>
      <% } %>

      <div class="mt-12 border-t border-pencil pt-8">
        <a
          href="/homes"
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-coral underline underline-offset-4 transition-colors hover:text-ink"
        >
          Browse all <%= total %> stays <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
      <% } else { %>
      <div class="mt-12 max-w-xl border-t border-pencil py-12">
        <h2 class="font-display text-2xl font-medium">No stays listed yet</h2>
        <p class="mt-3 text-sm leading-6 text-ink/60">
          Once a host publishes a home, it shows up here.
        </p>
        <a
          class="mt-6 inline-flex min-h-11 items-center justify-center rounded-sm bg-coral px-5 text-sm font-semibold text-white transition-colors hover:bg-ink focus-visible:outline-offset-4"
          href="/host/add-home"
          >List your home</a
        >
      </div>
      <% } %>
