<div class="group relative flex h-full flex-col">
  <div class="relative aspect-4/3 w-full overflow-hidden bg-mist">
    <a
      class="block h-full w-full"
      href="/host/home-detail/<%= home._id %>"
      aria-label="View <%= home.name %>"
    >
      <img
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        src="<%= home.url %>"
        alt="Photo of <%= home.name %>"
        loading="lazy"
      />
    </a>
    <div class="absolute right-3 top-3 z-10">
      <%- include("../shared/add-remove-favourite-form", { home: home }) %>
    </div>
  </div>
  <a
    class="flex flex-1 flex-col justify-between p-4 text-ink no-underline"
    href="/host/home-detail/<%= home._id %>"
  >
    <div class="mb-4">
      <h2 class="font-display text-lg font-medium leading-snug transition-colors group-hover:text-coral">
        <%= home.name %>
      </h2>
      <p class="mt-1 text-sm text-ink/60"><%= home.location %></p>
    </div>
    <p class="border-t border-pencil pt-3 text-sm text-ink">
      <span class="font-semibold"><%= home.formattedPrice %></span>
      <span class="text-ink/60">per night</span>
    </p>
  </a>
</div>
