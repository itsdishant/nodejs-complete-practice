<% 
  const withLabel = typeof showLabel !== "undefined" && showLabel; 
  const isFav = Boolean(home && home.isFavourite);
%>
<form
  action="/wishlist/<%= home._id %>"
  method="POST"
  class="inline-flex items-center"
>
  <button
    type="submit"
    class="group inline-flex items-center justify-center cursor-pointer transition-all duration-200 focus-visible:outline-offset-2 active:scale-95 <% if (withLabel) { %>gap-2 rounded-full border px-4 py-2 text-sm font-semibold shadow-xs <%= isFav ? 'border-coral bg-coral/10 text-coral hover:bg-coral/20 hover:border-coral' : 'border-pencil bg-white text-ink hover:border-ink/40 hover:bg-mist/50 hover:text-coral' %><% } else { %>h-9 w-9 shrink-0 rounded-full border shadow-sm backdrop-blur-sm hover:scale-105 <%= isFav ? 'border-coral bg-white text-coral hover:border-coral hover:bg-coral/5' : 'border-pencil bg-white/95 text-ink/70 hover:border-ink/40 hover:bg-white hover:text-coral' %><% } %>"
    aria-label="<%= isFav ? 'Remove from wishlist' : 'Save to wishlist' %>"
    aria-pressed="<%= isFav ? 'true' : 'false' %>"
    title="<%= isFav ? 'Remove from wishlist' : 'Save to wishlist' %>"
  >
    <i
      class="<%= isFav ? 'iconoir-heart-solid text-coral' : 'iconoir-heart text-current' %> text-lg shrink-0 transition-transform duration-200 group-hover:scale-110"
      aria-hidden="true"
    ></i>
    <% if (withLabel) { %>
    <span class="<%= isFav ? 'text-coral' : 'text-ink' %> transition-colors">
      <%= isFav ? "Saved" : "Wishlist" %>
    </span>
    <% } %>
  </button>
</form>
