<% if (typeof booking !== "undefined" && booking) { %>
<!-- Page Header -->
<header class="border-b border-pencil pb-8">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <div class="mb-2 flex items-center gap-2">
        <span class="inline-flex items-center rounded-xs border border-emerald-200/60 bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold text-emerald-800">
          Confirmed reservation
        </span>
      </div>

      <h1 class="font-display text-3xl font-medium tracking-tight text-ink sm:text-4xl lg:text-5xl">
        <%= booking.homeName %>
      </h1>

      <p class="mt-2 flex items-center text-sm text-ink/70">
        <i class="iconoir-map-pin mr-1.5 text-sm text-coral shrink-0" aria-hidden="true"></i>
        <span><%= booking.location %></span>
      </p>
    </div>

    <!-- Booking ID reference -->
    <div class="shrink-0">
      <%- include("../shared/booking-id", { id: booking.bookingId }) %>
    </div>
  </div>
</header>

<!-- Main Content Grid -->
<div class="mt-8 grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-12">
  <!-- Left Column: Stay Info & Guest Details (7 cols) -->
  <div class="space-y-8 lg:col-span-7">
    <!-- Property Photo Banner with View Listing Link -->
    <div class="group relative overflow-hidden rounded-sm border border-pencil bg-mist">
      <img
        src="<%= booking.photo || 'https://images.unsplash.com/photo-1596394516093-501ba68a0ba6?q=80&w=2340&auto=format&fit=crop' %>"
        alt="Photo of <%= booking.homeName %>"
        class="aspect-video w-full object-cover transition-transform duration-300 group-hover:scale-102"
      />
      <div class="absolute bottom-3 right-3">
        <a
          href="/home-detail/<%= booking.homeId?._id || booking.homeId %>"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-sm border border-white/40 bg-white/95 px-3 py-1.5 text-xs font-semibold text-ink shadow-xs backdrop-blur-xs transition-colors hover:bg-white hover:text-coral"
        >
          <span>View public listing</span>
          <i class="iconoir-open-new-window text-xs" aria-hidden="true"></i>
        </a>
      </div>
    </div>

    <!-- Schedule Section -->
    <section aria-labelledby="schedule-heading" class="border-b border-pencil pb-8">
      <h2 id="schedule-heading" class="font-display text-xl font-medium text-ink">
        Reservation schedule
      </h2>
      <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div class="rounded-sm border border-pencil bg-mist/20 p-4">
          <span class="text-xs font-semibold uppercase text-ink/50">Check-in</span>
          <p class="mt-1 font-display text-lg font-medium text-ink">
            <%= booking.checkIn || "Not set" %>
          </p>
        </div>

        <div class="rounded-sm border border-pencil bg-mist/20 p-4">
          <span class="text-xs font-semibold uppercase text-ink/50">Checkout</span>
          <p class="mt-1 font-display text-lg font-medium text-ink">
            <%= booking.checkOut || "Not set" %>
          </p>
        </div>
      </div>
    </section>

    <!-- Guest Information Section -->
    <section aria-labelledby="guest-heading" class="border-b border-pencil pb-8">
      <h2 id="guest-heading" class="font-display text-xl font-medium text-ink">
        Guest information
      </h2>

      <div class="mt-4 rounded-sm border border-pencil bg-white p-5 text-sm space-y-4">
        <!-- Guest Name with Initial Avatar -->
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-ink text-sm font-semibold text-white shadow-xs" aria-hidden="true">
            <%= (booking.fullName ? booking.fullName.trim().charAt(0) : "G").toUpperCase() %>
          </div>
          <div>
            <span class="block text-xs font-semibold uppercase text-ink/50">Primary Guest</span>
            <p class="font-display text-base font-semibold text-ink">
              <%= booking.fullName %>
            </p>
          </div>
        </div>

        <hr class="border-pencil/70" />

        <!-- Contact Rows -->
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="flex items-center gap-2 text-ink/60">
              <i class="iconoir-mail text-base text-ink/50" aria-hidden="true"></i>
              <span>Email address</span>
            </span>
            <% if (booking.email) { %>
            <a
              href="mailto:<%= booking.email %>"
              class="font-medium text-coral hover:underline"
            >
              <%= booking.email %>
            </a>
            <% } else { %>
            <span class="text-ink/50 italic">Not provided</span>
            <% } %>
          </div>

          <div class="flex items-center justify-between">
            <span class="flex items-center gap-2 text-ink/60">
              <i class="iconoir-phone text-base text-ink/50" aria-hidden="true"></i>
              <span>Phone number</span>
            </span>
            <% if (booking.phoneNumber) { %>
            <a
              href="tel:<%= booking.phoneNumber %>"
              class="font-medium text-ink hover:text-coral hover:underline"
            >
              <%= booking.phoneNumber %>
            </a>
            <% } else { %>
            <span class="text-ink/50 italic">Not provided</span>
            <% } %>
          </div>

          <div class="flex items-center justify-between border-t border-pencil/70 pt-3">
            <span class="flex items-center gap-2 text-ink/60">
              <i class="iconoir-user text-base text-ink/50" aria-hidden="true"></i>
              <span>Guests count</span>
            </span>
            <span class="font-medium text-ink">
              <%= booking.numberOfGuests %> <%= booking.numberOfGuests === 1 ? "guest" : "guests" %>
            </span>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Right Column: Sticky Payout & Summary Aside (5 cols) -->
  <aside aria-label="Payout Summary" class="lg:col-span-5">
    <div class="sticky top-6 space-y-4">
      <!-- Receipt & Financials Card -->
      <div class="rounded-sm border border-pencil bg-white p-6 sm:p-7 shadow-sm space-y-6">
        <h2 class="font-display text-xl font-medium text-ink">
          Payout summary
        </h2>

        <div class="space-y-3 text-sm text-ink/75">
          <div class="flex justify-between gap-4">
            <span>
              <%= booking.formattedNightlyRate %> &times; <%= booking.nights %> <%= booking.nights === 1 ? "night" : "nights" %>
            </span>
            <span class="font-medium text-ink"><%= booking.formattedNightsTotal %></span>
          </div>
          <div class="flex justify-between gap-4">
            <span>Cleaning fee</span>
            <span class="font-medium text-ink"><%= booking.formattedCleaningFee %></span>
          </div>
          <div class="flex justify-between gap-4">
            <span>Airbnb service fee</span>
            <span class="font-medium text-ink"><%= booking.formattedServiceFee %></span>
          </div>
        </div>

        <hr class="border-pencil" />

        <!-- Total Payout -->
        <div class="flex items-baseline justify-between gap-4 text-ink">
          <div>
            <span class="block text-base font-semibold">Total booking value</span>
            <span class="text-xs text-ink/50">Inclusive of all fees & taxes</span>
          </div>
          <span class="font-display text-2xl font-semibold text-ink">
            <%= booking.formattedTotal %>
          </span>
        </div>

        <div class="flex items-center justify-between border-t border-pencil/70 pt-4 text-sm text-ink/75">
          <span>Payment method</span>
          <span class="inline-flex items-center rounded-xs border border-pencil bg-mist/50 px-2.5 py-0.5 text-xs font-medium text-ink">
            <%= booking.paymentMethodLabel %>
          </span>
        </div>
      </div>

      <!-- Quick Action Card for Host -->
      <div class="rounded-sm border border-pencil bg-white p-5 shadow-2xs space-y-3">
        <span class="block text-xs font-semibold uppercase tracking-wider text-ink/50">
          Guest communication
        </span>
        <% if (booking.email) { %>
        <a
          href="mailto:<%= booking.email %>?subject=Regarding your booking at <%= booking.homeName %>"
          class="flex min-h-11 w-full items-center justify-center rounded-sm bg-coral px-4 text-sm font-semibold text-white transition-colors hover:bg-ink focus-visible:outline-offset-4"
        >
          <i class="iconoir-mail mr-2 text-base" aria-hidden="true"></i>
          <span>Send email to <%= booking.fullName.split(' ')[0] %></span>
        </a>
        <% } %>
        <% if (booking.phoneNumber) { %>
        <a
          href="tel:<%= booking.phoneNumber %>"
          class="flex min-h-11 w-full items-center justify-center rounded-sm border border-pencil bg-white px-4 text-sm font-semibold text-ink transition-colors hover:border-ink hover:bg-mist focus-visible:outline-offset-4"
        >
          <i class="iconoir-phone mr-2 text-base text-ink/60" aria-hidden="true"></i>
          <span>Call <%= booking.phoneNumber %></span>
        </a>
        <% } %>
      </div>
    </div>
  </aside>
</div>

<% } else { %>
<!-- Fallback / Not Found State -->
<section class="max-w-xl py-12">
  <h1 class="font-display text-3xl font-medium text-ink">Reservation not found</h1>
  <p class="mt-3 text-sm text-ink/70 leading-relaxed">
    The requested reservation does not exist or does not belong to any of your listed properties.
  </p>
  <div class="mt-6 flex items-center gap-4">
    <a
      href="/host/bookings"
      class="inline-flex min-h-11 items-center justify-center rounded-sm bg-coral px-5 text-sm font-semibold text-white transition-colors hover:bg-ink focus-visible:outline-offset-4"
    >
      Back to all reservations
    </a>
    <a
      href="/host/homes"
      class="inline-flex min-h-11 items-center justify-center rounded-sm border border-pencil bg-white px-5 text-sm font-semibold text-ink transition-colors hover:border-ink hover:bg-mist focus-visible:outline-offset-4"
    >
      View your listings
    </a>
  </div>
</section>
<% } %>

