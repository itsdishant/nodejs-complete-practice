<section aria-labelledby="host-bookings-heading" class="w-full">
  <!-- Page Header -->
  <header class="border-b border-pencil pb-8">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h1
          id="host-bookings-heading"
          class="font-display text-4xl font-medium leading-tight text-ink sm:text-5xl"
        >
          Property reservations
        </h1>
        <p class="mt-3 text-base text-ink/70">
          Track upcoming guest arrivals, schedules, and earnings across all your listed homes.
        </p>
      </div>
    </div>
  </header>

  <% if (bookings && bookings.length > 0) { %>
  <!-- Summary Metrics Bar -->
  <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-3">
    <!-- Stat 1: Total Bookings -->
    <div class="rounded-sm border border-pencil bg-white p-5 shadow-2xs">
      <span class="block text-xs font-semibold uppercase tracking-wider text-ink/50">
        Total reservations
      </span>
      <p class="mt-2 font-display text-3xl font-semibold text-ink">
        <%= stats.totalBookings %>
      </p>
      <span class="mt-1 block text-xs text-ink/60">
        Across all your active listings
      </span>
    </div>

    <!-- Stat 2: Total Nights Booked -->
    <div class="rounded-sm border border-pencil bg-white p-5 shadow-2xs">
      <span class="block text-xs font-semibold uppercase tracking-wider text-ink/50">
        Nights booked
      </span>
      <p class="mt-2 font-display text-3xl font-semibold text-ink">
        <%= stats.totalNights %>
      </p>
      <span class="mt-1 block text-xs text-ink/60">
        Total guest nights confirmed
      </span>
    </div>

    <!-- Stat 3: Total Revenue -->
    <div class="rounded-sm border border-pencil bg-white p-5 shadow-2xs">
      <span class="block text-xs font-semibold uppercase tracking-wider text-ink/50">
        Gross earnings
      </span>
      <p class="mt-2 font-display text-3xl font-semibold text-ink">
        <%= stats.totalRevenue %>
      </p>
      <span class="mt-1 block text-xs text-ink/60">
        Total value of all bookings
      </span>
    </div>
  </div>

  <!-- Bookings List Header -->
  <div class="mt-8 flex items-center justify-between text-sm text-ink/60">
    <p>
      <%= bookings.length %> <%= bookings.length === 1 ? "reservation" : "reservations" %> confirmed
    </p>
  </div>

  <!-- Responsive Bookings Table -->
  <div class="mt-4 overflow-hidden rounded-sm border border-pencil bg-white shadow-sm">
    <div class="overflow-x-auto">
      <table class="w-full min-w-180 text-left text-sm">
        <thead class="border-b border-pencil bg-mist/60 text-xs font-semibold uppercase tracking-wider text-ink/70">
          <tr>
            <th scope="col" class="py-3.5 pl-6 pr-4">Property</th>
            <th scope="col" class="px-4 py-3.5">Guest</th>
            <th scope="col" class="px-4 py-3.5">Dates</th>
            <th scope="col" class="px-4 py-3.5">Stay</th>
            <th scope="col" class="px-4 py-3.5">Total Payout</th>
            <th scope="col" class="py-3.5 pl-4 pr-6 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-pencil">
          <% for (const booking of bookings) { %>
          <tr class="transition-colors hover:bg-mist/20">
            <!-- Property -->
            <td class="py-4 pl-6 pr-4">
              <div class="flex items-center gap-3.5">
                <a
                  href="/host/bookings/<%= booking._id %>"
                  class="shrink-0 overflow-hidden rounded-sm border border-pencil"
                  aria-label="View booking for <%= booking.homeName %>"
                >
                  <img
                    class="h-14 w-20 object-cover transition-transform duration-200 hover:scale-105"
                    src="<%= booking.photo || 'https://images.unsplash.com/photo-1596394516093-501ba68a0ba6?q=80&w=2340&auto=format&fit=crop' %>"
                    alt="Photo of <%= booking.homeName %>"
                    loading="lazy"
                  />
                </a>
                <div class="min-w-0">
                  <a
                    href="/host/bookings/<%= booking._id %>"
                    class="block truncate font-display text-base font-medium text-ink transition-colors hover:text-coral"
                  >
                    <%= booking.homeName %>
                  </a>
                  <p class="truncate text-xs text-ink/60">
                    <%= booking.location %>
                  </p>
                  <span class="font-mono text-[11px] text-ink/40">
                    #<%= booking._id.slice(-6) %>
                  </span>
                </div>
              </div>
            </td>

            <!-- Guest Details -->
            <td class="px-4 py-4">
              <div class="flex flex-col">
                <span class="font-medium text-ink">
                  <%= booking.guestName %>
                </span>
                <% if (booking.guestEmail) { %>
                <span class="text-xs text-ink/60 truncate max-w-40">
                  <%= booking.guestEmail %>
                </span>
                <% } %>
                <% if (booking.guestPhone) { %>
                <span class="text-xs text-ink/50">
                  <%= booking.guestPhone %>
                </span>
                <% } %>
              </div>
            </td>

            <!-- Dates -->
            <td class="px-4 py-4 whitespace-nowrap">
              <div class="flex flex-col">
                <span class="font-medium text-ink text-xs">
                  <%= booking.checkIn %> &ndash; <%= booking.checkOut %>
                </span>
                <span class="mt-1 inline-flex w-fit items-center rounded-xs border border-emerald-200/60 bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold text-emerald-800">
                  Confirmed
                </span>
              </div>
            </td>

            <!-- Stay Info -->
            <td class="px-4 py-4 text-xs text-ink/80 whitespace-nowrap">
              <span class="font-medium text-ink">
                <%= booking.nights %> <%= booking.nights === 1 ? "night" : "nights" %>
              </span>
              <p class="text-ink/60">
                <%= booking.numberOfGuests %> <%= booking.numberOfGuests === 1 ? "guest" : "guests" %>
              </p>
            </td>

            <!-- Total Payout -->
            <td class="px-4 py-4 whitespace-nowrap">
              <span class="font-display font-semibold text-ink text-base">
                <%= booking.formattedPrice %>
              </span>
              <span class="block text-[11px] text-ink/50 uppercase">
                Paid via <%= booking.paymentMethod %>
              </span>
            </td>

            <!-- Actions -->
            <td class="py-4 pl-4 pr-6 text-right whitespace-nowrap">
              <a
                href="/host/bookings/<%= booking._id %>"
                class="inline-flex items-center gap-1.5 rounded-sm border border-pencil bg-white px-3.5 py-1.5 text-xs font-semibold text-ink transition-colors hover:border-coral hover:bg-coral hover:text-white focus-visible:outline-offset-4"
              >
                <span>View details</span>
                <i class="iconoir-arrow-right text-xs" aria-hidden="true"></i>
              </a>
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <% } else { %>
  <!-- Empty State -->
  <div class="max-w-xl py-10">
    <h2 class="font-display text-2xl font-medium text-ink sm:text-3xl">
      No reservations yet
    </h2>
    <p class="mt-3 text-base leading-relaxed text-ink/70">
      When guests book any of your properties, their reservation details, schedules, contact information, and payouts will appear here.
    </p>
    <div class="mt-6 flex flex-wrap items-center gap-4">
      <a
        href="/host/homes"
        class="inline-flex min-h-12 items-center justify-center rounded-sm bg-coral px-6 text-sm font-semibold text-white transition-colors hover:bg-ink focus-visible:outline-offset-4"
      >
        View your listings
      </a>
      <a
        href="/host/add-home"
        class="inline-flex min-h-12 items-center justify-center rounded-sm border border-pencil bg-white px-6 text-sm font-semibold text-ink transition-colors hover:border-ink hover:bg-mist focus-visible:outline-offset-4"
      >
        List another home
      </a>
    </div>
  </div>
  <% } %>
</section>

