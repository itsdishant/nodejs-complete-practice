      <section aria-labelledby="host-homes-heading" class="w-full">
        <!-- Header Bar -->
        <div
          class="flex flex-col gap-4 border-b border-pencil pb-8 sm:flex-row sm:items-end sm:justify-between"
        >
          <div>
            <h1
              id="host-homes-heading"
              class="font-display text-4xl font-medium leading-tight sm:text-5xl"
            >
              Your listings
            </h1>
            <p class="mt-3 text-base text-ink/70">
              Keep your pricing, photos, and property details up to date.
            </p>
          </div>
          <div class="shrink-0">
            <a
              href="/host/add-home"
              class="inline-flex min-h-11 items-center justify-center rounded-sm bg-coral px-5 text-sm font-semibold text-white transition-colors hover:bg-ink focus-visible:outline-offset-4"
            >
              Add listing
            </a>
          </div>
        </div>

        <% if (homes && homes.length > 0) { %>
        <!-- Listings Count -->
        <div class="mt-6 flex items-center justify-between text-sm text-ink/60">
          <p>
            <%= homes.length %> <%= homes.length === 1 ? "home listed" : "homes listed" %>
          </p>
        </div>

        <!-- Table Container -->
        <div
          class="mt-4 overflow-hidden rounded-sm border border-pencil bg-white shadow-sm"
        >
          <div class="overflow-x-auto">
            <table class="w-full min-w-160 text-left text-sm">
              <thead
                class="border-b border-pencil bg-mist/60 text-xs font-semibold uppercase tracking-wider text-ink/70"
              >
                <tr>
                  <th scope="col" class="py-3.5 pl-6 pr-4">Home</th>
                  <th scope="col" class="px-4 py-3.5">Location</th>
                  <th scope="col" class="px-4 py-3.5">Price</th>
                  <th scope="col" class="py-3.5 pl-4 pr-6 text-center">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-pencil">
                <% for (const home of homes) { %>
                <tr class="transition-colors hover:bg-mist/20">
                  <!-- Photo & Name -->
                  <td class="py-4 pl-6 pr-4">
                    <div class="flex items-center gap-4">
                      <a
                        href="/home-detail/<%= home._id %>"
                        class="shrink-0"
                      >
                        <img
                          class="h-14 w-20 rounded-sm border border-pencil object-cover transition-opacity hover:opacity-90"
                          src="<%= home.url %>"
                          alt="Photo of <%= home.name %>"
                          loading="lazy"
                        />
                      </a>
                      <div class="min-w-0">
                        <a
                          href="/home-detail/<%= home._id %>"
                          class="font-display text-base font-medium text-ink transition-colors hover:text-coral"
                        >
                          <%= home.name %>
                        </a>
                        <p class="truncate text-xs text-ink/60 sm:hidden">
                          <%= home.location %>
                        </p>
                      </div>
                    </div>
                  </td>

                  <!-- Location -->
                  <td class="px-4 py-4 text-sm text-ink/70">
                    <%= home.location %>
                  </td>

                  <!-- Price -->
                  <td class="whitespace-nowrap px-4 py-4">
                    <span class="font-semibold text-ink">
                      <%= home.formattedPrice %>
                    </span>
                    <span class="text-xs text-ink/60"> / night</span>
                  </td>

                  <!-- Actions (Edit & View) -->
                  <td class="whitespace-nowrap py-4 pl-4 pr-6 text-right">
                    <div class="inline-flex items-center gap-2">
                      <a
                        href="/host/edit-home/<%= home._id %>"
                        class="inline-flex items-center gap-1.5 rounded-sm border border-pencil bg-white px-3 py-1.5 text-xs font-semibold text-ink transition-colors hover:border-coral hover:bg-coral hover:text-white focus-visible:outline-offset-4"
                        aria-label="Edit <%= home.name %>"
                      >
                        <i class="iconoir-edit-pencil text-sm shrink-0" aria-hidden="true"></i>
                        Edit
                      </a>
                      <form action="/host/delete-home/<%= home._id %>" method="POST">
                        <input type="hidden" name="_method" value="DELETE">
                        <button
                          class="inline-flex items-center gap-1.5 rounded-sm border border-pencil bg-white px-3 py-1.5 text-xs font-semibold text-ink transition-colors hover:border-coral hover:bg-coral hover:text-white focus-visible:outline-offset-4"
                          aria-label="Delete <%= home.name %>"
                          type="submit"
                        >
                          <i class="iconoir-trash text-sm shrink-0" aria-hidden="true"></i>
                          Delete
                        </button>
                      </form> 
                    </div>
                  </td>
                </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
        <% } else { %>
        <!-- Empty State -->
        <div class="max-w-xl py-12">
          <h2 class="font-display text-2xl font-medium text-ink">
            No listings yet
          </h2>
          <p class="mt-3 text-sm leading-6 text-ink/60">
            You haven't listed any homes yet. Once you add a place, you can track and edit details right here.
          </p>
          <a
            class="mt-6 inline-flex min-h-11 items-center justify-center rounded-sm bg-coral px-5 text-sm font-semibold text-white transition-colors hover:bg-ink focus-visible:outline-offset-4"
            href="/host/add-home"
          >
            Create your first listing
          </a>
        </div>
        <% } %>
      </section>
