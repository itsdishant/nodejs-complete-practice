      <section aria-labelledby="favourite-heading" class="w-full">
        <div class="border-b border-pencil pb-8">
          <h1
            id="favourite-heading"
            class="font-display text-4xl font-medium leading-tight sm:text-5xl"
          >
            Saved homes
          </h1>
          <p class="mt-3 text-base text-ink/70">
            Stays that you have saved as favourites.
          </p>
        </div>
        <% if (favouriteList.length > 0) { %>
        <div class="mt-8">
          <p class="mb-5 text-sm text-ink/60">
            <%= favouriteList.length %> <%= favouriteList.length === 1 ? "home" : "homes" %>
          </p>
          <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            <% for (const home of favouriteList) { %>
            <li class="flex flex-col overflow-hidden rounded-sm border border-pencil bg-white">
              <%- include("../shared/single-home-card", { home: home }) %>
            </li>
            <% } %>
          </ul>
        </div>
        <% } else { %>
        <div class="max-w-xl py-12">
          <h2 class="font-display text-2xl font-medium">No saved homes yet</h2>
          <p class="mt-3 text-sm leading-6 text-ink/60">
            When you see a spot you like, save it to keep track of it here.
          </p>
          <a
            class="mt-6 inline-flex min-h-11 items-center justify-center rounded-sm bg-coral px-5 text-sm font-semibold text-white transition-colors hover:bg-ink focus-visible:outline-offset-4"
            href="/host/homes-list"
            >Explore homes</a
          >
        </div>
        <% } %>
      </section>
