<% 
  const host = home.host || (home.hostId && typeof home.hostId === "object" ? home.hostId : null);
  let hostingSince = "Recently";
  const userRole = (typeof cookies !== "undefined" && cookies && cookies.userDetails && cookies.userDetails.role);
  const isLoggedIn = (typeof cookies !== "undefined" && cookies && cookies.isLoggedIn);
  if (host && host.createdAt) {
    const d = new Date(host.createdAt);
    if (!isNaN(d.getTime())) {
      hostingSince = d.toLocaleDateString("en-US", { month: "long", year: "numeric" });
    }
  }
%>

<div class="w-full">
  <!-- 2-Column Main Layout: Left Column = Listing Content & Image; Right Column = Sticky Sidebar -->
  <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-12 xl:gap-16">
    <!-- Left Column: Title, Image, Description, Details -->
    <div class="space-y-8 lg:col-span-7 xl:col-span-8">
      <!-- Title & Location Header with Wishlist Button -->
      <header class="border-b border-pencil pb-6">
        <h1
          class="font-display text-3xl font-medium tracking-tight text-ink sm:text-4xl lg:text-5xl"
        >
          <%= home.name %>
        </h1>

        <div class="mt-4 flex items-center justify-between gap-4">
          <div class="flex items-center gap-1.5 text-sm text-ink/70">
            <i class="iconoir-map-pin text-ink/50 text-sm shrink-0" aria-hidden="true"></i>
            <span><%= home.location %></span>
          </div>

          <% if (userRole !== 'host') { %>
          <div>
            <%- include("../shared/toggle-wishlist-form", { home: home, showLabel: true }) %>
          </div>
          <% } %>
        </div>
      </header>

      <!-- Property Photo Banner: Width matches the section below, standard height -->
      <section aria-label="Property Photo">
        <div class="overflow-hidden rounded-sm border border-pencil bg-mist">
          <img
            class="h-80 sm:h-96 lg:h-[460px] w-full object-cover object-center"
            src="<%= home.url %>"
            alt="Photograph of <%= home.name %> in <%= home.location %>"
            loading="eager"
          />
        </div>
      </section>

        <!-- Description Section: About this home -->
      <div>
        <h3 class="font-display text-xl font-medium text-ink">
          About this home
        </h3>
        <p class="mt-4 text-base leading-7 text-ink/80">
          Welcome to <%= home.name %> in <%= home.location %>. This is a
          comfortable place to stay with plenty of room to relax, whether
          you are traveling for work, visiting family, or taking a weekend
          trip.
        </p>
        <p class="mt-3 text-base leading-7 text-ink/80">
          Local cafes, small groceries, and transit stops are an easy walk
          away, making it simple to get around the neighborhood.
        </p>
      </div>
    </div>

    
    <!-- Right Column: Sticky Sidebar with Reserve Form & Host Details -->
    <aside aria-label="Reservation and Host" class="lg:col-span-5 xl:col-span-4">
      <div class="sticky top-6 space-y-4">
        <!-- Reservation Form Card -->
        <% if (userRole !== 'host') { %>
        <div class="rounded-sm border border-pencil bg-white p-6 shadow-sm">
          <!-- Booking Form -->
          <% if (isLoggedIn) { %>
          <form
            action="/reserve/<%= home._id %>"
            method="GET"
            class="mx-auto mt-0 w-full"
          >
            <div class="rounded-sm border border-pencil">
              <div
                class="grid grid-cols-2 divide-x divide-pencil border-b border-pencil"
              >
                <label for="checkIn" class="block cursor-pointer p-2.5">
                  <span
                    class="block text-[10px] font-semibold uppercase text-ink/60"
                  >
                    Check-in
                  </span>
                  <input
                    type="date"
                    id="checkIn"
                    name="checkIn"
                    class="mt-0.5 block w-full bg-transparent text-xs font-medium text-ink focus:outline-none"
                    required
                  />
                </label>
                <label for="checkOut" class="block cursor-pointer p-2.5">
                  <span
                    class="block text-[10px] font-semibold uppercase text-ink/60"
                  >
                    Checkout
                  </span>
                  <input
                    type="date"
                    id="checkOut"
                    name="checkOut"
                    class="mt-0.5 block w-full bg-transparent text-xs font-medium text-ink focus:outline-none"
                    required
                  />
                </label>
              </div>
              <label for="guests" class="block cursor-pointer p-2.5">
                <span
                  class="block text-[10px] font-semibold uppercase text-ink/60"
                >
                  Guests
                </span>
                <select
                  id="guests"
                  name="guests"
                  class="mt-0.5 block w-full bg-transparent text-xs font-medium text-ink focus:outline-none"
                >
                  <option value="1">1 guest</option>
                  <option value="2" selected>2 guests</option>
                  <option value="3">3 guests</option>
                  <option value="4">4 guests</option>
                  <option value="5">5 guests</option>
                </select>
              </label>
            </div>

            <!-- Reserve Button -->
            <button
              type="submit"
              class="mt-4 flex min-h-12 w-full items-center justify-center rounded-sm bg-coral px-6 text-sm font-semibold text-white transition-colors hover:bg-ink focus-visible:outline-offset-4"
            >
              Reserve
            </button>

            <p class="mt-3 text-center text-xs text-ink/50">
              You won't be charged yet
            </p>
          </form>
          <% } else { %>
          <a href="/login" class="flex min-h-12 w-full items-center justify-center rounded-sm bg-coral px-6 text-sm font-semibold text-white transition-colors hover:bg-ink focus-visible:outline-offset-4">
            Login to reserve
          </a>
          <% } %>
        </div>
        <% } %>

        <!-- Listing Details Card -->
        <div class="rounded-sm border border-pencil bg-white p-6 shadow-sm">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-ink/50">
            Listing details
          </h3>

          <dl class="mt-4 divide-y divide-pencil text-xs">
            <div class="flex items-center justify-between py-2.5">
              <dt class="text-ink/60">Location</dt>
              <dd class="font-medium text-ink text-right truncate ml-4">
                <%= home.location %>
              </dd>
            </div>
            <div class="flex items-center justify-between py-2.5">
              <dt class="text-ink/60">Price per night</dt>
              <dd class="font-semibold text-ink text-right">
                <%= typeof home.formattedPrice !== "undefined" ? home.formattedPrice : "₹" + home.price %>
              </dd>
            </div>
          </dl>
        </div>

        <!-- Host Details Card -->
        <div class="rounded-sm border border-pencil bg-white p-6 shadow-sm">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-ink/50">
            Host information
          </h3>

          <div class="mt-4 flex items-center gap-3.5">
            <div
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-ink text-base font-semibold text-white shadow-xs"
              aria-hidden="true"
            >
              <%= (host && host.fullName ? host.fullName.trim().charAt(0) : "H").toUpperCase() %>
            </div>
            <div class="min-w-0 flex-1">
              <h4 class="truncate font-display text-lg font-semibold text-ink">
                <%= host && host.fullName ? host.fullName : "Host" %>
              </h4>
              <p class="flex items-center gap-1.5 text-xs text-ink/60">
                <i class="iconoir-calendar text-sm shrink-0" aria-hidden="true"></i>
                <span>Hosting since <%= hostingSince %></span>
              </p>
            </div>
          </div>

          <div class="mt-5 space-y-3 border-t border-pencil pt-4 text-xs">
            <div class="flex items-start gap-2.5 text-ink/80">
              <i class="iconoir-mail text-base text-ink/50 shrink-0 mt-0.5" aria-hidden="true"></i>
              <div class="min-w-0 flex-1">
                <span class="block text-[10px] font-semibold uppercase tracking-wider text-ink/50">Contact email</span>
                <% if (host && host.email) { %>
                  <a
                    href="mailto:<%= host.email %>"
                    class="truncate block font-medium text-coral hover:text-ink hover:underline"
                    title="<%= host.email %>"
                  >
                    <%= host.email %>
                  </a>
                <% } else { %>
                  <span class="text-ink/60 italic">Not available</span>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </aside>
  </div>
</div>

<script>
  (function () {
    const checkInInput = document.getElementById("checkIn");
    const checkOutInput = document.getElementById("checkOut");
    if (checkInInput && checkOutInput) {
      const today = new Date();
      const tomorrow = new Date(today);
      tomorrow.setDate(tomorrow.getDate() + 1);
      const fiveDaysLater = new Date(today);
      fiveDaysLater.setDate(fiveDaysLater.getDate() + 6);

      const formatDate = (d) => d.toISOString().split("T")[0];
      checkInInput.value = formatDate(tomorrow);
      checkInInput.min = formatDate(today);
      checkOutInput.value = formatDate(fiveDaysLater);
      checkOutInput.min = formatDate(tomorrow);

      checkInInput.addEventListener("change", function () {
        const nextDay = new Date(this.value);
        nextDay.setDate(nextDay.getDate() + 1);
        checkOutInput.min = formatDate(nextDay);
        if (new Date(checkOutInput.value) <= new Date(this.value)) {
          checkOutInput.value = formatDate(nextDay);
        }
      });
    }
  })();
</script>
