<section class="mx-auto w-full max-w-md">
  <h1 class="font-display text-3xl font-medium tracking-tight text-ink sm:text-4xl">
    Create your account
  </h1>
  <p class="mt-3 text-base text-ink/70">
    Join Airbnb to book unique places to stay, save your favourites, or start hosting.
  </p>

  <% if (typeof formError !=="undefined" && formError) { %>
    <div class="mt-6 rounded-sm border border-coral/30 bg-coral/5 px-4 py-3 text-sm text-ink" role="alert">
      <%= formError %>
    </div>
    <% } else if (typeof error !=="undefined" && error) { %>
      <div class="mt-6 rounded-sm border border-coral/30 bg-coral/5 px-4 py-3 text-sm text-ink" role="alert">
        <%= error %>
      </div>
      <% } %>

        <form class="mt-8 w-full space-y-5 rounded-sm border border-pencil bg-white p-6 shadow-sm" action="/signup"
          method="POST" novalidate>
          <!-- Full Name field -->
          <div class="space-y-1.5">
            <label class="block text-sm font-medium text-ink" for="fullName">
              Full Name
            </label>
            <input
              class="min-h-12 w-full rounded-sm border border-pencil bg-paper px-4 text-base text-ink transition-colors placeholder:text-ink/40 focus:border-coral focus:outline-none"
              id="fullName" type="text" name="fullName" autocomplete="fullName" placeholder="John Doe"
              value="<%= typeof formValues !== 'undefined' && formValues && formValues.fullName ? formValues.fullName : '' %>"
              required />
          </div>

          <!-- Email field -->
          <div class="space-y-1.5">
            <label class="block text-sm font-medium text-ink" for="email">
              Email address
            </label>
            <input
              class="min-h-12 w-full rounded-sm border border-pencil bg-paper px-4 text-base text-ink transition-colors placeholder:text-ink/40 focus:border-coral focus:outline-none"
              id="email" type="email" name="email" autocomplete="email" placeholder="you@example.com"
              value="<%= typeof formValues !== 'undefined' && formValues && formValues.email ? formValues.email : '' %>"
              required />
          </div>

          <!-- Password field -->
          <div class="space-y-1.5">
            <label class="block text-sm font-medium text-ink" for="password">
              Password
            </label>
            <div class="relative">
              <input
                class="min-h-12 w-full rounded-sm border border-pencil bg-paper px-4 pr-16 text-base text-ink transition-colors placeholder:text-ink/40 focus:border-coral focus:outline-none"
                id="password" type="password" name="password" autocomplete="new-password"
                placeholder="At least 6 characters" minlength="6" required />
              <button type="button" id="toggle-password"
                class="absolute inset-y-0 right-0 flex items-center px-4 text-xs font-semibold text-ink/60 transition-colors hover:text-ink focus-visible:outline-offset-2"
                aria-label="Show password">
                Show
              </button>
            </div>
          </div>

          <!-- Account Intent / Role Selection -->
          <div class="space-y-2 pt-1">
            <span class="block text-sm font-medium text-ink">
              How do you plan to use Airbnb?
            </span>
            <div class="grid grid-cols-2 gap-3">
              <label
                class="flex cursor-pointer items-start gap-3 rounded-sm border border-pencil bg-white p-3.5 transition-colors has-checked:border-coral has-checked:bg-coral/5">
                <input type="radio" name="role" value="guest"
                  class="mt-0.5 h-4 w-4 accent-coral focus-visible:outline-offset-2" <%=typeof formValues==='undefined'
                  || !formValues || formValues.role !=='host' ? 'checked' : '' %>
                />
                <div>
                  <span class="block text-sm font-semibold text-ink">Traveler</span>
                  <span class="block text-xs text-ink/60">I want to book stays</span>
                </div>
              </label>

              <label
                class="flex cursor-pointer items-start gap-3 rounded-sm border border-pencil bg-white p-3.5 transition-colors has-checked:border-coral has-checked:bg-coral/5">
                <input type="radio" name="role" value="host"
                  class="mt-0.5 h-4 w-4 accent-coral focus-visible:outline-offset-2" <%=typeof formValues !=='undefined'
                  && formValues && formValues.role==='host' ? 'checked' : '' %>
                />
                <div>
                  <span class="block text-sm font-semibold text-ink">Host</span>
                  <span class="block text-xs text-ink/60">I want to list spaces</span>
                </div>
              </label>
            </div>
          </div>

          <!-- Submit CTA -->
          <button
            class="min-h-12 w-full rounded-sm bg-coral px-6 text-sm font-semibold text-white transition-colors hover:bg-ink focus-visible:outline-offset-4"
            type="submit">
            Sign Up
          </button>
        </form>

        <!-- Divider -->
        <div class="relative my-8">
          <div class="absolute inset-0 flex items-center" aria-hidden="true">
            <div class="w-full border-t border-pencil"></div>
          </div>
          <div class="relative flex justify-center text-xs text-ink/50 uppercase">
            <span class="bg-paper px-3">or</span>
          </div>
        </div>

        <!-- Switch to Login -->
        <p class="text-center text-sm text-ink/70">
          Already have an account?
          <a href="/login"
            class="font-semibold text-coral transition-colors hover:text-ink hover:underline focus-visible:outline-offset-2">
            Log in
          </a>
        </p>
</section>

<script>
  (function () {
    const btn = document.getElementById("toggle-password");
    const input = document.getElementById("password");
    if (!btn || !input) return;
    btn.addEventListener("click", function () {
      const isPwd = input.type === "password";
      input.type = isPwd ? "text" : "password";
      btn.textContent = isPwd ? "Hide" : "Show";
      btn.setAttribute("aria-label", isPwd ? "Hide password" : "Show password");
    });
  })();
</script>