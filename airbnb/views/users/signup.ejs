<section class="w-full">
  <div class="grid grid-cols-1 items-stretch gap-8 lg:grid-cols-12 lg:gap-12">
    
    <!-- Left column: Registration form -->
    <div class="flex flex-col justify-center lg:col-span-6 xl:col-span-5">
      <div class="w-full">
        <h1 class="font-display text-3xl font-medium tracking-tight text-ink sm:text-4xl">
          Create your account
        </h1>
        <p class="mt-3 text-base text-ink/70">
          Join Airbnb to book unique places to stay, save your favourites, or start hosting.
        </p>

        <% if (typeof formError !== "undefined" && formError) { %>
          <div
            class="mt-6 rounded-sm border border-coral/30 bg-coral/5 px-4 py-3 text-sm text-ink"
            role="alert"
          >
            <%= formError %>
          </div>
        <% } else if (typeof error !== "undefined" && error) { %>
          <div
            class="mt-6 rounded-sm border border-coral/30 bg-coral/5 px-4 py-3 text-sm text-ink"
            role="alert"
          >
            <%= error %>
          </div>
        <% } %>

        <form class="mt-8 space-y-5" action="/signup" method="POST" novalidate>
          <!-- Email field -->
          <div class="space-y-1.5">
            <label class="block text-sm font-medium text-ink" for="email">
              Email address
            </label>
            <input
              class="min-h-12 w-full rounded-sm border border-pencil bg-paper px-4 text-base text-ink transition-colors placeholder:text-ink/40 focus:border-coral focus:outline-none"
              id="email"
              type="email"
              name="email"
              autocomplete="email"
              placeholder="you@example.com"
              value="<%= typeof formValues !== 'undefined' && formValues && formValues.email ? formValues.email : '' %>"
              required
            />
          </div>

          <!-- Password field -->
          <div class="space-y-1.5">
            <label class="block text-sm font-medium text-ink" for="password">
              Password
            </label>
            <div class="relative">
              <input
                class="min-h-12 w-full rounded-sm border border-pencil bg-paper px-4 pr-16 text-base text-ink transition-colors placeholder:text-ink/40 focus:border-coral focus:outline-none"
                id="password"
                type="password"
                name="password"
                autocomplete="new-password"
                placeholder="At least 6 characters"
                minlength="6"
                required
              />
              <button
                type="button"
                id="toggle-password"
                class="absolute inset-y-0 right-0 flex items-center px-4 text-xs font-semibold text-ink/60 transition-colors hover:text-ink focus-visible:outline-offset-2"
                aria-label="Show password"
              >
                Show
              </button>
            </div>
          </div>

          <!-- Account Intent / Role Selection -->
          <div class="space-y-2 pt-1">
            <span class="block text-sm font-medium text-ink">
              How do you plan to use Airbnb?
            </span>
            <div class="grid grid-cols-2 gap-3">
              <label class="flex cursor-pointer items-start gap-3 rounded-sm border border-pencil bg-white p-3.5 transition-colors has-[:checked]:border-coral has-[:checked]:bg-coral/5">
                <input
                  type="radio"
                  name="role"
                  value="guest"
                  class="mt-0.5 h-4 w-4 accent-coral focus-visible:outline-offset-2"
                  <%= typeof formValues === 'undefined' || !formValues || formValues.role !== 'host' ? 'checked' : '' %>
                />
                <div>
                  <span class="block text-sm font-semibold text-ink">Traveler</span>
                  <span class="block text-xs text-ink/60">I want to book stays</span>
                </div>
              </label>

              <label class="flex cursor-pointer items-start gap-3 rounded-sm border border-pencil bg-white p-3.5 transition-colors has-[:checked]:border-coral has-[:checked]:bg-coral/5">
                <input
                  type="radio"
                  name="role"
                  value="host"
                  class="mt-0.5 h-4 w-4 accent-coral focus-visible:outline-offset-2"
                  <%= typeof formValues !== 'undefined' && formValues && formValues.role === 'host' ? 'checked' : '' %>
                />
                <div>
                  <span class="block text-sm font-semibold text-ink">Host</span>
                  <span class="block text-xs text-ink/60">I want to list spaces</span>
                </div>
              </label>
            </div>
          </div>

          <!-- Terms Agreement Disclaimer -->
          <p class="pt-1 text-xs leading-relaxed text-ink/60">
            By selecting Agree and continue, you agree to Airbnb's
            <a href="#" class="text-ink underline hover:text-coral">Terms of Service</a>
            and acknowledge our
            <a href="#" class="text-ink underline hover:text-coral">Privacy Policy</a>.
          </p>

          <!-- Submit CTA -->
          <button
            class="min-h-12 w-full rounded-sm bg-coral px-6 text-sm font-semibold text-white transition-colors hover:bg-ink focus-visible:outline-offset-4"
            type="submit"
          >
            Agree and continue
          </button>
        </form>

        <!-- Divider -->
        <div class="relative my-8">
          <div class="absolute inset-0 flex items-center" aria-hidden="true">
            <div class="w-full border-t border-pencil"></div>
          </div>
          <div class="relative flex justify-center text-xs text-ink/50 uppercase">
            <span class="bg-paper px-3">or</span>
          </div>
        </div>

        <!-- Switch to Login -->
        <p class="text-center text-sm text-ink/70">
          Already have an account?
          <a
            href="/login"
            class="font-semibold text-coral transition-colors hover:text-ink hover:underline focus-visible:outline-offset-2"
          >
            Log in
          </a>
        </p>
      </div>
    </div>

    <!-- Right column: Editorial showcase -->
    <div class="hidden lg:col-span-6 xl:col-span-7 lg:flex lg:flex-col lg:justify-center">
      <div class="relative overflow-hidden rounded-sm border border-pencil bg-mist shadow-xs">
        <img
          src="https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?q=80&w=1600&auto=format&fit=crop"
          alt="Sunlit mountain chalet surrounded by pine trees"
          class="aspect-4/5 max-h-[580px] w-full object-cover"
          loading="lazy"
        />
        
        <!-- Story badge overlay -->
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/70 via-ink/30 to-transparent p-6 text-white sm:p-8">
          <p class="font-display text-lg font-medium tracking-tight text-white sm:text-xl">
            "The best journeys are the ones that make you feel right at home."
          </p>
          <div class="mt-3 flex items-center justify-between text-xs text-white/80">
            <span class="font-medium text-white">The Cedar Chalet · Manali, Himachal Pradesh</span>
            <span>Hosted by Arjun</span>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  (function () {
    const btn = document.getElementById("toggle-password");
    const input = document.getElementById("password");
    if (!btn || !input) return;
    btn.addEventListener("click", function () {
      const isPwd = input.type === "password";
      input.type = isPwd ? "text" : "password";
      btn.textContent = isPwd ? "Hide" : "Show";
      btn.setAttribute("aria-label", isPwd ? "Hide password" : "Show password");
    });
  })();
</script>
