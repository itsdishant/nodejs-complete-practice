<% 
const user = (typeof userDetails !== "undefined" && userDetails) ||
  (typeof session !== "undefined" && session && session.userDetails);
const userRole = user ? user.role : null;
const isAuth = Boolean(
  (typeof isLoggedIn !== "undefined" && isLoggedIn) ||
  (typeof session !== "undefined" && session && session.isLoggedIn)
);
const isFullWidth = Boolean(
  (typeof fullWidth !== "undefined" && fullWidth) ||
  (typeof fullWidthHeader !== "undefined" && fullWidthHeader)
);
// currentPath is the absolute path (e.g. "/host/homes"), so mounted routers
// match here without guessing whether the mount prefix was stripped.
const onYourListings =
  currentPath === "/host/homes" || currentPath.startsWith("/host/edit-home");
const onHostBookings =
  currentPath === "/host/bookings" || currentPath.startsWith("/host/bookings/");
const userName = user && user.fullName ? user.fullName : "User";
const initial = (userName.trim().charAt(0) || "U").toUpperCase();

// One source of truth for the links: the inline row and the mobile panel both
// render this list, so the two never drift apart.
const links = [];
if (isAuth) {
  if (userRole !== "host") {
    links.push({ href: "/homes", label: "Explore", icon: "iconoir-compass", active: currentPath === "/homes" });
    links.push({ href: "/bookings", label: "Bookings", icon: "iconoir-calendar", active: currentPath === "/bookings" });
    links.push({ href: "/wishlist", label: "Wishlist", icon: "iconoir-heart", active: currentPath === "/wishlist" });
  } else {
    links.push({ href: "/host/homes", label: "Your listings", icon: "iconoir-home", active: onYourListings });
    links.push({ href: "/host/bookings", label: "Bookings", icon: "iconoir-calendar", active: onHostBookings });
    links.push({ href: "/host/add-home", label: "Airbnb your home", icon: "iconoir-sparks", active: currentPath === "/host/add-home", cta: true });
  }
  links.push({ href: "/logout", label: "Logout", icon: "iconoir-log-out", active: currentPath === "/logout" });
} else {
  links.push({ href: "/login", label: "Login", icon: "iconoir-log-in", active: currentPath === "/login" });
}
%>
<header class="sticky top-0 z-40 bg-cloud px-4 sm:px-6">
  <nav
    aria-label="Main navigation"
    class="mx-auto flex w-full <%= isFullWidth ? 'max-w-full' : 'max-w-280' %> items-center justify-between gap-3 py-3 sm:gap-4 sm:py-3.5"
  >
    <a
      class="group inline-flex shrink-0 items-center gap-2 text-coral transition-opacity hover:opacity-85 sm:gap-2.5"
      href="/"
      aria-label="Airbnb home"
    >
      <svg
        class="h-6 w-6 shrink-0 transition-transform duration-200 group-hover:-translate-y-0.5 sm:h-7 sm:w-7"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M20 10C20 14.4183 12 22 12 22C12 22 4 14.4183 4 10C4 5.58172 7.58172 2 12 2C16.4183 2 20 5.58172 20 10Z" />
        <path d="M12 11C12.5523 11 13 10.5523 13 10C13 9.44772 12.5523 9 12 9C11.4477 9 11 9.44772 11 10C11 10.5523 11.4477 11 12 11Z" fill="currentColor" />
      </svg>
      <span
        class="font-display text-xl font-semibold tracking-tight sm:text-2xl"
        >airbnb</span
      >
    </a>

    <!-- Inline navigation: md and up -->
    <div class="hidden items-center gap-2 md:flex">
      <% for (const link of links) { %>
      <a
        class="<%= link.cta ? 'nav-cta' : 'nav-link' %><%= link.active ? (link.cta ? ' nav-cta-active' : ' nav-link-active') : '' %>"
        href="<%= link.href %>"
        aria-current="<%= link.active ? 'page' : 'false' %>"
      >
        <i class="<%= link.icon %>" aria-hidden="true"></i>
        <span><%= link.label %></span>
      </a>
      <% } %>

      <% if (isAuth) { %>
      <!-- Identity chip -->
      <div
        class="ml-1 inline-flex shrink-0 select-none items-center gap-2.5 rounded-full border border-pencil bg-white py-1 pl-1 pr-3.5 text-ink shadow-xs transition-colors hover:border-ink/30"
        title="Signed in as <%= userName %> (<%= userRole || 'traveller' %>)"
      >
        <span class="relative flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-ink text-[11px] font-semibold text-white">
          <%= initial %>
          <span
            class="absolute -bottom-0.5 -right-0.5 h-2.5 w-2.5 rounded-full border-2 border-white bg-coral"
            aria-hidden="true"
          ></span>
          <span class="sr-only">Signed in</span>
        </span>
        <span class="flex flex-col leading-tight">
          <span class="max-w-22.5 truncate text-xs font-semibold text-ink sm:max-w-30 lg:max-w-45">
            <%= userName %>
          </span>
          <span class="text-[10px] font-medium uppercase tracking-[0.14em] text-ink/50">
            <%= userRole || "traveller" %>
          </span>
        </span>
      </div>
      <% } %>
    </div>

    <% if (isAuth) { %>
    <!-- Collapsed menu: below md -->
    <details id="nav-menu" class="group relative md:hidden">
      <summary
        class="flex cursor-pointer list-none items-center gap-2 rounded-full border border-pencil bg-white py-1 pl-1 pr-3 text-ink shadow-xs transition-colors hover:border-ink/30 [&::-webkit-details-marker]:hidden"
        aria-label="Menu"
      >
        <span class="relative flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-ink text-[11px] font-semibold text-white">
          <%= initial %>
          <span
            class="absolute -bottom-0.5 -right-0.5 h-2.5 w-2.5 rounded-full border-2 border-white bg-coral"
            aria-hidden="true"
          ></span>
        </span>
        <span class="group-open:hidden"><i class="iconoir-menu text-lg text-ink/70" aria-hidden="true"></i></span>
        <span class="hidden group-open:block"><i class="iconoir-xmark text-lg text-ink/70" aria-hidden="true"></i></span>
      </summary>

      <div
        class="absolute right-0 top-full mt-2 w-64 rounded-sm border border-pencil bg-white p-2 shadow-lg"
      >
        <div class="flex items-center gap-3 border-b border-pencil px-3 pb-3 pt-1">
          <span class="relative flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-ink text-xs font-semibold text-white">
            <%= initial %>
            <span
              class="absolute -bottom-0.5 -right-0.5 h-2.5 w-2.5 rounded-full border-2 border-white bg-coral"
              aria-hidden="true"
            ></span>
          </span>
          <span class="min-w-0 leading-tight">
            <span class="block truncate text-sm font-semibold text-ink"><%= userName %></span>
            <span class="block text-[10px] font-medium uppercase tracking-[0.14em] text-ink/50">
              <%= userRole || "traveller" %>
            </span>
          </span>
        </div>

        <div class="pt-1">
          <% for (const link of links) { %>
          <a
            class="group/link flex items-center gap-3 rounded-sm px-3 py-2.5 text-sm font-medium transition-colors <%= link.cta ? 'bg-ink text-white hover:bg-coral' : link.active ? 'bg-mist text-ink' : 'text-ink/80 hover:bg-mist hover:text-ink' %>"
            href="<%= link.href %>"
            aria-current="<%= link.active ? 'page' : 'false' %>"
          >
            <i
              class="<%= link.icon %> shrink-0 text-base <%= link.cta ? 'text-coral group-hover/link:text-white' : 'text-ink/50' %>"
              aria-hidden="true"
            ></i>
            <span><%= link.label %></span>
          </a>
          <% } %>
        </div>
      </div>
    </details>
    <% } else { %>
    <!-- Signed out: one destination, so no menu -->
    <a
      class="nav-link<%= currentPath === '/login' ? ' nav-link-active' : '' %> md:hidden"
      href="/login"
      aria-current="<%= currentPath === '/login' ? 'page' : 'false' %>"
    >
      <i class="iconoir-log-in" aria-hidden="true"></i>
      <span>Login</span>
    </a>
    <% } %>
  </nav>
</header>

<script>
  // The menu is a native <details>, so it only needs help closing itself.
  (() => {
    const menu = document.getElementById("nav-menu");
    if (!menu) return;
    document.addEventListener("click", (event) => {
      if (menu.open && !menu.contains(event.target)) menu.open = false;
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") menu.open = false;
    });
  })();
</script>
