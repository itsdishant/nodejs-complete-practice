<% 
const user = (typeof userDetails !== "undefined" && userDetails) ||
  (typeof session !== "undefined" && session && session.userDetails);
const userRole = user ? user.role : null;
const isAuth = Boolean(
  (typeof isLoggedIn !== "undefined" && isLoggedIn) ||
  (typeof session !== "undefined" && session && session.isLoggedIn)
);
const isFullWidth = Boolean(
  (typeof fullWidth !== "undefined" && fullWidth) ||
  (typeof fullWidthHeader !== "undefined" && fullWidthHeader)
);
%>
<header
  class="sticky top-0 z-40 border-b border-[#ebebeb] bg-white"
>
  <nav
    aria-label="Main navigation"
    class="mx-auto flex w-full <%= isFullWidth ? 'max-w-full px-4 sm:px-6 lg:px-8' : 'max-w-280 px-4 sm:px-6' %> items-center justify-between gap-3 py-3 sm:gap-4 sm:py-3.5"
  >
    <a
      class="shrink-0 font-display text-xl font-semibold tracking-tight sm:text-2xl transition-opacity hover:opacity-85"
      href="/"
      aria-label="Airbnb home"
      >airbnb<span class="text-coral">.</span></a
    >

    <div
      class="no-scrollbar flex max-w-[calc(100%-80px)] items-center gap-1.5 overflow-x-auto py-1 sm:max-w-none sm:gap-2"
    >

      <% if (isAuth) { %>
  
      <% if (userRole !== 'host') { %>
        
      <!-- Explore -->
      <a
        class="nav-link<%= currentPath === '/homes-list' ? ' nav-link-active' : '' %>"
        href="/host/homes-list"
        aria-current="<%= currentPath === '/homes-list' ? 'page' : 'false' %>"
      >
        <i class="iconoir-compass" aria-hidden="true"></i>
        <span>Explore</span>
      </a>

      <!-- Bookings -->
      <a
        class="nav-link<%= currentPath === '/bookings' ? ' nav-link-active' : '' %>"
        href="/bookings"
        aria-current="<%= currentPath === '/bookings' ? 'page' : 'false' %>"
      >
        <i class="iconoir-calendar" aria-hidden="true"></i>
        <span>Bookings</span>
      </a>

      <!-- Wishlist -->
      <a
        class="nav-link<%= currentPath === '/wishlist' ? ' nav-link-active' : '' %>"
        href="/wishlist"
        aria-current="<%= currentPath === '/wishlist' ? 'page' : 'false' %>"
      >
        <i class="iconoir-heart" aria-hidden="true"></i>
        <span>Wishlist</span>
      </a>

      <% } else { %>

      <!-- Your listings -->
      <a
        class="nav-link<%= currentPath === '/host-homes-list' ? ' nav-link-active' : '' %>"
        href="/host/host-homes-list"
        aria-current="<%= currentPath === '/host-homes-list' ? 'page' : 'false' %>"
      >
        <i class="iconoir-home" aria-hidden="true"></i>
        <span>Your listings</span>
      </a>

      <!-- Airbnb your home -->
      <a
        class="nav-link<%= currentPath === '/add-home' ? ' nav-link-active' : '' %>"
        href="/host/add-home"
        aria-current="<%= currentPath === '/add-home' ? 'page' : 'false' %>"
      >
        <i class="iconoir-sparks" aria-hidden="true"></i>
        <span>Airbnb your home</span>
      </a>

      <% } %>

      <!-- Logout -->
      <a
        class="nav-link<%= currentPath === '/logout' ? ' nav-link-active' : '' %>"
        href="/logout"
        aria-current="<%= currentPath === '/logout' ? 'page' : 'false' %>"
        title="Logout"
      >
        <i class="iconoir-log-out" aria-hidden="true"></i>
        <span>Logout</span>
      </a>

      <!-- Logged-in User Profile Badge -->
      <div
        class="inline-flex shrink-0 items-center gap-2 rounded-full border border-pencil bg-paper py-1 pl-1.5 pr-3 text-ink select-none sm:gap-2.5 sm:py-1.5 sm:pl-2 sm:pr-3.5"
        title="Logged in as <%= user && user.fullName ? user.fullName : 'User' %> (<%= userRole || 'guest' %>)"
      >
        <div
          class="flex h-6 w-6 sm:h-7 sm:w-7 shrink-0 items-center justify-center rounded-full bg-ink text-[11px] sm:text-xs font-semibold text-white shadow-xs"
          aria-hidden="true"
        >
          <%= (user && user.fullName ? user.fullName.trim().charAt(0) : "U").toUpperCase() %>
        </div>
        <div class="flex flex-col text-left leading-tight">
          <span class="max-w-[90px] sm:max-w-[130px] md:max-w-[180px] truncate text-xs font-semibold text-ink">
            <%= user && user.fullName ? user.fullName : "User" %>
          </span>
          <span class="text-[9px] sm:text-[10px] uppercase tracking-wider text-ink/50 font-medium">
            <%= userRole || "guest" %>
          </span>
        </div>
      </div>

      <% } else { %>
      <!-- Login -->
      <a
        class="nav-link<%= currentPath === '/login' ? ' nav-link-active' : '' %>"
        href="/login"
        aria-current="<%= currentPath === '/login' ? 'page' : 'false' %>"
      >
        <i class="iconoir-log-in" aria-hidden="true"></i>
        <span>Login</span>
      </a>
      <% } %>
      
    </div>
  </nav>
</header>
