<% const isAuth = Boolean(
          (typeof isLoggedIn !== "undefined" && isLoggedIn) ||
          (typeof cookies !== "undefined" && cookies && (cookies.isLoggedIn === "true" || cookies.isLoggedIn === true || cookies.userDetails))
        );
  const userRole = (typeof cookies !== "undefined" && cookies && cookies.userDetails && cookies.userDetails.role);
        %>
<header
  class="sticky top-0 z-40 border-b border-[#ebebeb] bg-white"
>
  <nav
    aria-label="Main navigation"
    class="mx-auto flex w-full max-w-[1120px] items-center justify-between gap-3 px-4 py-3 sm:gap-4 sm:px-6 sm:py-3.5"
  >
    <a
      class="shrink-0 font-display text-xl font-semibold tracking-tight sm:text-2xl transition-opacity hover:opacity-85"
      href="/"
      aria-label="Airbnb home"
      >airbnb<span class="text-coral">.</span></a
    >

    <div
      class="no-scrollbar flex max-w-[calc(100%-80px)] items-center gap-1.5 overflow-x-auto py-1 sm:max-w-none sm:gap-2"
    >

      <% if (isAuth) { %>
  
      <% if (userRole !== 'host') { %>
        
      <!-- Explore -->
      <a
        class="nav-link<%= currentPath === '/homes-list' ? ' nav-link-active' : '' %>"
        href="/host/homes-list"
        aria-current="<%= currentPath === '/homes-list' ? 'page' : 'false' %>"
      >
        <i class="iconoir-compass" aria-hidden="true"></i>
        <span>Explore</span>
      </a>

      <!-- Bookings -->
      <a
        class="nav-link<%= currentPath === '/bookings' ? ' nav-link-active' : '' %>"
        href="/bookings"
        aria-current="<%= currentPath === '/bookings' ? 'page' : 'false' %>"
      >
        <i class="iconoir-calendar" aria-hidden="true"></i>
        <span>Bookings</span>
      </a>

      <!-- Wishlist -->
      <a
        class="nav-link<%= currentPath === '/wishlist' ? ' nav-link-active' : '' %>"
        href="/wishlist"
        aria-current="<%= currentPath === '/wishlist' ? 'page' : 'false' %>"
      >
        <i class="iconoir-heart" aria-hidden="true"></i>
        <span>Wishlist</span>
      </a>

      <% } else { %>

      <!-- Your listings -->
      <a
        class="nav-link<%= currentPath === '/host-homes-list' ? ' nav-link-active' : '' %>"
        href="/host/host-homes-list"
        aria-current="<%= currentPath === '/host-homes-list' ? 'page' : 'false' %>"
      >
        <i class="iconoir-home" aria-hidden="true"></i>
        <span>Your listings</span>
      </a>

      <!-- Airbnb your home -->
      <a
        class="nav-link<%= currentPath === '/add-home' ? ' nav-link-active' : '' %>"
        href="/host/add-home"
        aria-current="<%= currentPath === '/add-home' ? 'page' : 'false' %>"
      >
        <i class="iconoir-sparks" aria-hidden="true"></i>
        <span>Airbnb your home</span>
      </a>

      <% } %>

      <!-- Logout -->
      <a
        class="nav-link<%= currentPath === '/logout' ? ' nav-link-active' : '' %>"
        href="/logout"
        aria-current="<%= currentPath === '/logout' ? 'page' : 'false' %>"
      >
        <i class="iconoir-log-out" aria-hidden="true"></i>
        <span>Logout</span>
      </a>

      <% } else { %>
      <!-- Login -->
      <a
        class="nav-link<%= currentPath === '/login' ? ' nav-link-active' : '' %>"
        href="/login"
        aria-current="<%= currentPath === '/login' ? 'page' : 'false' %>"
      >
        <i class="iconoir-log-in" aria-hidden="true"></i>
        <span>Login</span>
      </a>
      <% } %>
    </div>
  </nav>
</header>
